{
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-env --allow-run --allow-net=127.0.0.1 tests",
    "check": "deno check src/**/*.ts",
    "package": "deno run --allow-read --allow-write --allow-run=git scripts/package.ts",
    "npm-package": "deno run --no-config --allow-read --allow-write --allow-run=git scripts/npm-package.ts",
    "npm-check": "deno run --no-config --no-remote --no-npm --allow-read --allow-write --allow-run --allow-env scripts/npm-check.ts",
    "qbento": "deno run --allow-read --allow-write --allow-run --allow-env --allow-net=127.0.0.1 src/cli.ts"
  },
  "compilerOptions": { "strict": true },
  "nodeModulesDir": "none",
  "fmt": { "exclude": ["vendor/"] },
  "lint": { "exclude": ["vendor/"] }
}
